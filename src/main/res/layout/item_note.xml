<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Hairline-ruled, border-defined note row: 0px radius, 1px border. -->
    <merge>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/note_row_background"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/note_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/shae_ink"
                    android:textStyle="bold"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <TextView
                    android:id="@+id/note_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/shae_ink"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:maxLines="2" />

                <TextView
                    android:id="@+id/note_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#6E6B63"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/note_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:text="🗑"
                android:textColor="@color/shae_oxide"
                android:padding="8dp" />
        </FrameLayout>
    </merge>
</layout>
