<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/shae_paper"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/form_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/shae_ink"
                android:textStyle="bold"
                android:textAppearance="?attr/textAppearanceHeadlineSmall" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:background="@color/shae_ink" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_title"
                style="@style/Widget.Shae.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/note_title">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/shae_ink" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/input_content"
                style="@style/Widget.Shae.TextField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/note_content">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edit_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine"
                    android:minLines="6"
                    android:textColor="@color/shae_ink" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/text_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/error_required"
                android:textColor="@color/shae_oxide"
                android:textAppearance="?attr/textAppearanceCaption"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <Button
                    android:id="@+id/button_cancel"
                    style="@style/Widget.Shae.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/button_cancel" />

                <Button
                    android:id="@+id/button_delete"
                    style="@style/Widget.Shae.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/button_delete" />

                <Button
                    android:id="@+id/button_save"
                    style="@style/Widget.Shae.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="@color/shae_oxide"
                    android:text="@string/button_save" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</layout>
