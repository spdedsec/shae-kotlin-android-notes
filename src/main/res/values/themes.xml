<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- SHAE: no elevation/shadow, 0px radius, hairline 1px border -->
    <style name="Theme.ShaeNotes" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/shae_oxide</item>
        <item name="colorPrimaryVariant">@color/shae_ink</item>
        <item name="colorSecondary">@color/shae_oxide</item>
        <item name="android:windowBackground">@color/shae_paper</item>
        <item name="materialButtonStyle">@style/Widget.Shae.Button</item>
    </style>

    <style name="Widget.Shae.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/shae_ink</item>
        <item name="backgroundTint">@color/shae_paper</item>
        <item name="android:textColor">@color/shae_ink</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Shae.TextField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="cornerRadius">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="boxStrokeColor">@color/shae_ink</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxBackgroundColor">@color/shae_paper</item>
        <item name="elevation">0dp</item>
    </style>
</resources>
